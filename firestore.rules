rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Active agent mission & nodes session state for browser refresh resumption
      match /session/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      // Imported AI conversations archive
      match /imported_conversations/{conversationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(userId);
      }

      // Unconfirmed imported conversations awaiting operator review & staging resumption
      match /unconfirmed_conversations/{conversationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(userId);
      }

      // Swarm Blackboard persistent data (tasks, tools, integrations, memory files)
      match /blackboard/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }

    // Cloud coordinated missions
    match /missions/{missionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Debrief conversation subcollection
      match /debrief/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
