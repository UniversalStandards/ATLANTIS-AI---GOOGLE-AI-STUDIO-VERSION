{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Atlantis AI operator profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["operator", "commander", "auditor"] },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "CloudMission": {
      "title": "CloudMission",
      "description": "Episodic mission recorded in the cloud",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "sector": { "type": "string" },
        "topology": { "type": "string" },
        "status": { "type": "string" },
        "result": { "type": "string" },
        "timestamp": { "type": "number" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "executionTimeMs": { "type": "number" },
        "nodesCount": { "type": "number" },
        "curiosityFactor": { "type": "string" }
      },
      "required": ["title", "sector", "topology", "status", "timestamp", "userId"]
    },
    "DebriefMessage": {
      "title": "DebriefMessage",
      "description": "Supervisor debrief interaction message",
      "type": "object",
      "properties": {
        "missionId": { "type": "string" },
        "userId": { "type": "string" },
        "sender": { "type": "string", "enum": ["operator", "supervisor"] },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "modelTier": { "type": "string" }
      },
      "required": ["missionId", "userId", "sender", "content", "timestamp"]
    },
    "ImportedConversation": {
      "title": "ImportedConversation",
      "description": "Imported external AI conversation transcript for contextual grounding",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "platform": { "type": "string" },
        "sourceFormat": { "type": "string", "enum": ["json", "pdf", "txt", "csv", "api"] },
        "messageCount": { "type": "number" },
        "characterCount": { "type": "number" },
        "summary": { "type": "string" },
        "activeForContext": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "title", "platform", "sourceFormat", "messageCount", "activeForContext", "timestamp"]
    },
    "ActiveSession": {
      "title": "ActiveSession",
      "description": "Persisted active agent mission and tree nodes state for browser session resumption",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "activeMission": { "type": "object" },
        "nodes": { "type": "object" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "updatedAt"]
    },
    "UnconfirmedConversation": {
      "title": "UnconfirmedConversation",
      "description": "Unconfirmed imported conversation transcript stored for user review and subsequent confirmation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "platform": { "type": "string" },
        "sourceFormat": { "type": "string" },
        "messageCount": { "type": "number" },
        "characterCount": { "type": "number" },
        "summary": { "type": "string" },
        "stagedAt": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "userId", "title", "platform", "sourceFormat", "messageCount", "stagedAt"]
    },
    "BlackboardState": {
      "title": "BlackboardState",
      "description": "Persisted Swarm Blackboard data including tasks, forged tools, external integrations, and memory files",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["tasks", "tools", "integrations", "memory"] },
        "items": { "type": "array" },
        "contextMemory": { "type": "string" },
        "swarmLog": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "type", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/session/{sessionId}": {
      "schema": "ActiveSession",
      "description": "Persisted active agent mission and nodes session"
    },
    "/missions/{missionId}": {
      "schema": "CloudMission",
      "description": "Shared multi-agent coordination missions"
    },
    "/missions/{missionId}/debrief/{messageId}": {
      "schema": "DebriefMessage",
      "description": "Multi-turn Supervisor debrief conversation thread"
    },
    "/users/{userId}/imported_conversations/{conversationId}": {
      "schema": "ImportedConversation",
      "description": "Operator imported external AI conversation history"
    },
    "/users/{userId}/unconfirmed_conversations/{conversationId}": {
      "schema": "UnconfirmedConversation",
      "description": "Unconfirmed imported conversations awaiting user review and confirmation"
    },
    "/users/{userId}/blackboard/{docId}": {
      "schema": "BlackboardState",
      "description": "Swarm Blackboard persistent data for tasks, tools, integrations, and memory"
    }
  }
}
